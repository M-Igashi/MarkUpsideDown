{
  "name": "markupsidedown-converter",
  "main": "src/index.ts",
  // 2026-03-27 or later is required by the browser binding's quickAction()
  // and the AI Search namespace binding.
  "compatibility_date": "2026-03-27",
  "ai": {
    "binding": "AI"
  },
  // Browser Run Quick Actions (/render, /json). No API token needed.
  "browser": {
    "binding": "BROWSER"
  },
  // Semantic search. The instance is created on first use.
  "ai_search_namespaces": [
    { "binding": "AI_SEARCH", "namespace": "default" }
  ],
  "r2_buckets": [
    { "binding": "PUBLISH_BUCKET", "bucket_name": "markupsidedown-publish" }
  ],
  // Set R2_PUBLIC_URL after enabling R2 public access in Cloudflare dashboard.
  // Example: "https://pub-abc123.r2.dev"
  // "vars": { "R2_PUBLIC_URL": "" },
  // Deletes expired published documents (only kept when the R2 bucket exists).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
